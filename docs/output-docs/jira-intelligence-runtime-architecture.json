  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "浏览器发起已鉴权操作；Next.js API 进入共享分析流水线。",
        "流水线调用 Qwen 生成分析结论；成功响应后浏览器再写入 IndexedDB。",
        "CANtrace 读取、解码和绘图只在 Step 2 已成功映射信号后发生。"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖（为避免杂乱不额外连线）",
      "items": [
        "Jira REST：JQL、详情、附件、评论和工作流回填。",
        "飞书项目 / 附件插件：MQL、工作项上下文、附件与人工复核回填。",
        "Python CAN 解码、飞书 Webhook 与 Docupedia：仅在各自受控服务路径中使用。"
      ]
    },
    {
      "dot": "rose",
      "title": "信任与数据边界",
      "items": [
        "浏览器 IndexedDB 是主要业务持久化；Jira 与飞书项目来源表相互隔离。",
        "Jira Basic Auth 仅发送到 Jira 主机，不向飞书或附件插件泄露。",
        "运行产物以不可变 runId 隔离；artifactRef 采用白名单只读访问。"
      ]
    }
  ]
}
