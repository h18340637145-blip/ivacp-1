    { "id": "filter", "lane": "orchestrator", "col": 1, "type": "backend", "label": "并发筛选来源", "sublabel": "JQL 与 MQL 相互隔离", "width": 154 },
    { "id": "snapshot", "lane": "orchestrator", "col": 2, "type": "database", "label": "保存快照与任务", "sublabel": "IndexedDB；task ID 作 runId", "width": 162 },
    { "id": "process", "lane": "pipeline", "col": 3, "type": "backend", "label": "POST /api/issues/process", "sublabel": "共享 Jira / Meegle 入口", "width": 168 },
