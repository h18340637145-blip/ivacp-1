  "cards": [
    { "dot": "cyan", "title": "主工作流", "items": ["Jira 与飞书项目在统一看板中编排，但筛选数据、任务与失败状态彼此隔离。", "飞书项目在创建 snapshot / task 后直接调用共享处理 API；兼容 /api/meegle/analyze 不是正常路径。"] },
    { "dot": "amber", "title": "关键数据依赖", "items": ["AI Step 1 提取需求，AI Step 2 提取并配置映射信号。", "只有 mapped signals 存在时才读取、解码或绘制 CANtrace；无匹配时跳过该分支。"] },
    { "dot": "rose", "title": "完成边界", "items": ["浏览器只在外层 HTTP 成功后写入当前结果；服务端完成不等于前端已持久化。", "Docupedia 是 success-only 的异步归档，失败不阻断结果；人工复核是 Jira / 飞书回填的门禁。"] }
