{
  "name": "ivacp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "terminal:gateway": "tsx terminal-gateway/server.ts",
    "dev:with-terminal": "concurrently \"next dev --webpack\" \"tsx terminal-gateway/server.ts\"",
    "migrate:legacy": "node --env-file-if-exists=.env --import tsx scripts/migrate-legacy.ts",
    "jira:attachments": "node scripts/download-jira-attachments.mjs",
    "cleanup:data": "node scripts/cleanup-old-data.mjs",
    "baseline:golden": "node scripts/build-golden-baseline.mjs",
    "eval:accuracy": "tsx scripts/eval-accuracy.ts",
    "eval:coverage": "tsx scripts/eval-set-coverage.ts",
    "eval:export-truth": "node --env-file-if-exists=.env --import tsx scripts/export-eval-set.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.11",
    "next": "16.2.4",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "ws": "^8.21.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
